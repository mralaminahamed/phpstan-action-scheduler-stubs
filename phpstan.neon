parameters:
    level: 5

    # The hand-written PHP, which is all this repository actually authors.
    paths:
        - configs
        - tests

    # The stubs are SCANNED, not analysed.
    #
    # They used to sit in `paths`, which asks PHPStan to check the bodies of declarations that are
    # empty by definition -- every one reported "should return string but return statement is
    # missing", plus "extends unknown class WP_List_Table" for the WordPress admin classes upstream
    # touches. Around 330 errors, none of them a defect in this package.
    #
    # That was suppressed with an ignoreErrors pattern until PHPStan 2.x classified `return.missing`
    # and `class.notFound` as non-ignorable, at which point the suppression itself became the error
    # and `composer analyze` could not pass at all. A baseline could not hold them either, for the
    # same reason.
    #
    # Scanning makes the symbols known without asserting anything about their bodies, which is the
    # only claim a generated stub can honour. What the stubs are checked FOR -- that they parse, and
    # that they still match upstream's public surface -- is tests/StubsTest.php, where the assertion
    # is about the thing that actually matters.
    scanFiles:
        - action-scheduler-stubs.stub
        - action-scheduler-constants-stubs.stub

    bootstrapFiles:
        - configs/bootstrap.php
